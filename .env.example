R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY=your-access-key-id
R2_SECRET_KEY=your-secret-access-key
R2_BUCKET=your-bucket-name
# Bucket jurisdiction: "eu" or "fedramp". Leave empty for the default region
# (an EU *location hint* is not a jurisdiction — leave this empty for those).
R2_JURISDICTION=
# Optional "folder" prefix for uploaded objects, e.g. kt-infografik/
R2_PREFIX=
